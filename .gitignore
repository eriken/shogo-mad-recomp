# Build output
/build/
/build-*/

# Monolith's Shogo source (shogsrc22.zip): its EULA forbids redistribution.
/third_party/shogsrc22/
/shogo_sourcecode22.zip
shogsrc22.zip

# The user's own copy of the game (GOG installer and extracted data).
/gamedata/
/setup_shogo_*.exe

.DS_Store

# Ordinary diffs of Monolith's game code quote their source, so they stay
# local; our changes are kept as patches/*.hpatch, which quote none (see README).
/patches/*.patch
